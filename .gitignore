# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Public CA intermediate cert (not a secret) needed to complete the AED
# open-data source's incomplete TLS chain — see lib/aedService.ts.
!/certs/twca-secure-ssl-intermediate.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# merchant self-service passcodes — real credentials, never commit
/data/merchant-accounts.json

# runtime-generated logs / customer data — written by the server, not seed
# content; must never carry real customer PII or usage logs into git history
/data/bookings.json
/data/click-events.json
/data/admin-audit-log.json

# scripts/backup-data.mjs output — contains merchant passcodes and bookings
/backups

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by scripts/build-capacitor-shell.mjs (npm run cap:shell)
/capacitor-shell

# stale build output left behind by interrupted `next build` / turbopack runs
.next.stale-*
.next.turbo-stale-*
# generated release staging copies of the native projects
/dist
# local dev server log
/daxi.log

# self-hosted telemetry — usage and error logs, never seed content
/data/events.ndjson
/data/client-errors.ndjson
/data/login-lockouts.json
# session revocation counters — runtime state, and committing them would
# resurrect a revoked session on the next deploy
/data/session-epochs.json
# device push tokens — user data written at runtime, never seed content
/data/push-tokens.json
/data/coupon-redemptions.json
